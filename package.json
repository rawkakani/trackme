{
  "name": "sd",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "bun run --filter @sd/api dev",
    "build": "bun run --filter @sd/web build",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "bunx biome check .",
    "format": "bunx biome format --write .",
    "key:create": "bun run apps/api/src/scripts/key-create.ts",
    "seed": "bun run apps/api/src/scripts/seed.ts",
    "tech:rotate": "bun run apps/api/src/scripts/tech-rotate.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.7.3"
  }
}
